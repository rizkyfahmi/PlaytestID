APP_NAME=Testoplay
APP_ENV=production
APP_KEY=base64:ytOxqHnh7KvJrhuCfqZVrZgAik1YlKMNSKCLQHpRFa4=
APP_DEBUG=false
APP_URL=https://your-project.vercel.app

VERCEL=1
APP_STORAGE=/tmp/storage
VIEW_COMPILED_PATH=/tmp/views

LOG_CHANNEL=stderr
LOG_LEVEL=error

# Production Database (Cloud MySQL, e.g. Aiven, Railway, Supabase, PlanetScale)
DB_CONNECTION=mysql
DB_HOST=your-cloud-db-host
DB_PORT=3306
DB_DATABASE=testoplay
DB_USERNAME=your-db-user
DB_PASSWORD=your-db-password

SESSION_DRIVER=cookie
CACHE_STORE=array
QUEUE_CONNECTION=sync
